# Copy to .env.telegram-test and fill in the values locally.
# Never commit .env.telegram-test or send Telegram tokens in chat.
TELEGRAM_TEST_BOT_TOKEN=PASTE_TEST_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_TEST_MASTER_ADMIN=YOUR_NUMERIC_TELEGRAM_USER_ID

# Optional: use dedicated development-provider keys to test AI features.
# If omitted, production AI keys are deliberately not inherited.
TELEGRAM_TEST_OPENAI_API_KEYS=
TELEGRAM_TEST_ELEVENLABS_API_KEY=

# To share web PRO cache and vocabulary intentionally, use the exact same
# database URI as your website. This may update your web learning records.
TELEGRAM_TEST_MONGODB_URI=
